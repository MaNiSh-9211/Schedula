# Schedula/.env.example - template (committed). NO real values.
# Used by docker-compose.yml / Spring config

SCHEDULA_DB_URL=jdbc:postgresql://postgres:5432/schedula
SCHEDULA_DB_USER=schedula
SCHEDULA_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_USER=schedula
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=schedula

# API keys - generate strong random values for real deployments
SCHEDULA_DEFAULT_API_KEY=CHANGE_ME_API_KEY
SCHEDULA_ADMIN_KEY=CHANGE_ME_ADMIN_KEY

SPRING_PROFILES_ACTIVE=demo
